model
  schema 1.1

type account
  relations
    define doctor: [doctor#account]
    define hospital: [hospital]
    define nurse: nurse from hospital

type hospital
  relations
    define nurse: [nurse#account]

type doctor
  relations
    define account: [account]

type nurse
  relations
    define account: [account]

type medical_record
  relations
    define owner: [account]
    define can_view: owner or doctor from owner or nurse from owner
    define can_edit: owner or doctor from owner
